// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// TENANTS (Müştərilər)
// ==========================================
model Tenant {
  id              String   @id @default(uuid())
  name            String
  businessType    String   // "restaurant" | "hotel" | "fitness" | "clinic" | "salon" | "other"
  email           String   @unique
  phone           String?
  twilioNumber    String?  @unique
  retellAgentId   String?  @unique

  // Business Info
  address         String?
  city            String?
  country         String?
  timezone        String   @default("UTC")
  website         String?
  
  // Business Hours (JSON)
  businessHours   Json?    // { "monday": { "open": "09:00", "close": "22:00" }, ... }
  
  // Integrations
  squareLocationId String?
  googleCalendarId String?
  googleSheetId   String?
  googleAccessToken String?
  googleRefreshToken String?
  posConfig       Json?    // POS integration configuration

  // Subscription
  plan            String   @default("free") // "free" | "basic" | "pro" | "enterprise"
  subscriptionStatus String @default("trial") // "trial" | "active" | "cancelled" | "suspended"
  subscriptionId  String?  // Square subscription ID
  trialEndsAt     DateTime?
  currentPeriodEnd DateTime?
  
  // Settings
  settings        Json?    // Additional settings
  
  // Relations
  users           User[]
  services        Service[]
  faqs            FAQ[]
  bookings        Booking[]
  orders          Order[]
  calls           Call[]
  qrCodes         QRCode[]
  subscription    Subscription?
  integration     TenantIntegration?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([twilioNumber])
  @@index([retellAgentId])
  @@index([plan])
  @@map("tenants")
}

// ==========================================
// USERS (Tenant istifadəçiləri)
// ==========================================
model User {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("owner") // "owner" | "manager" | "staff"
  
  // Profile
  phone         String?
  avatar        String?
  
  // Status
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  // Email Verification
  emailVerified Boolean  @default(false)
  verificationToken String?
  verificationTokenExpires DateTime?

  // One-Time Password (OTP) for password setup
  temporaryPassword String?
  temporaryPasswordExpires DateTime?
  temporaryPasswordUsed Boolean @default(false)

  // Admin Approval
  adminApproved Boolean  @default(false)
  approvedAt    DateTime?
  approvedBy    String?  // AdminUser ID who approved

  // Relations
  certifiedRep  CertifiedRep?  // User can be a Certified Rep

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([tenantId])
  @@map("users")
}

// ==========================================
// LEADS (Potensial müştərilər)
// ==========================================
model Lead {
  id              String   @id @default(uuid())
  
  // Source
  source          String   // "landing_page_form" | "ai_call" | "contact_form" | "referral"
  campaign        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  
  // Contact
  contactName     String
  email           String
  phone           String
  preferredContact String? @default("phone") // "phone" | "email"
  
  // Business
  businessName    String
  businessType    String
  website         String?
  address         String?
  callVolume      Int?     // Estimated daily call volume
  
  // Plan Selection
  selectedPlan    String   // "basic" | "pro" | "enterprise"
  
  // Requirements
  challenges      String?  // Current problems
  requirements    String?  // Special requirements
  budget          String?
  urgency         String?  // "immediate" | "week" | "month" | "exploring"
  
  // AI Data (if source = ai_call)
  callId          String?
  callDuration    Int?     // seconds
  callRecordingUrl String?
  callTranscript  String?  @db.Text
  aiConfidence    Float?
  aiNotes         String?  @db.Text
  aiCallData      Json?    // Structured data from AI call

  // Status
  status          String   @default("new") 
  // "new" | "contacted" | "qualified" | "in_progress" | "converted" | "lost"
  
  priority        String   @default("normal") 
  // "low" | "normal" | "high" | "hot"
  
  qualificationScore Int?  // 0-100
  
  // Admin
  adminNotes      String?  @db.Text
  assignedToEmail String?
  lostReason      String?
  
  // Conversion
  convertedToTenantId String?
  convertedAt     DateTime?
  
  // Follow-up
  nextFollowUp    DateTime?
  lastContacted   DateTime?
  followUpCount   Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@map("leads")
}

// ==========================================
// SERVICES (Universal - Menu/Services)
// ==========================================
model Service {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?  @db.Text
  category      String?
  price         Float
  duration      Int?     // minutes (for services)
  available     Boolean  @default(true)
  image         String?
  
  // Modifiers (for restaurants)
  modifiers     Json?    // { "size": ["Small", "Medium", "Large"], "toppings": [...] }
  
  // Inventory
  stockQuantity Int?
  lowStockAlert Int?
  
  // Sorting
  sortOrder     Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([available])
  @@map("services")
}

// ==========================================
// FAQ
// ==========================================
model FAQ {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  question      String
  answer        String   @db.Text
  keywords      String[] // For search
  category      String?
  
  // Analytics
  viewCount     Int      @default(0)
  helpfulCount  Int      @default(0)
  
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@map("faqs")
}

// ==========================================
// BOOKINGS (Reservations)
// ==========================================
model Booking {
  id            String   @id @default(uuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Customer
  customerName  String
  customerPhone String?
  customerEmail String?
  
  // Service
  serviceId     String?
  serviceName   String
  
  // Date & Time
  dateTime      DateTime
  duration      Int?     // minutes
  partySize     Int?     // for restaurants
  
  // Status
  status        String   @default("pending") 
  // "pending" | "confirmed" | "cancelled" | "completed" | "no_show"
  
  // Notes
  notes         String?  @db.Text
  specialRequests String?
  
  // Integrations
  googleEventId String?
  externalBookingId String?  // POS booking ID

  // Notifications
  reminderSent  Boolean  @default(false)
  confirmationSent Boolean @default(false)
  
  // Cancellation
  cancelledAt   DateTime?
  cancelReason  String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([dateTime])
  @@index([status])
  @@index([customerPhone])
  @@map("bookings")
}

// ==========================================
// ORDERS (for restaurants, retail, etc)
// ==========================================
model Order {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Customer
  customerPhone String
  customerName  String?
  customerEmail String?
  
  // Items
  items         Json     // [{ serviceId, name, price, quantity, modifiers }]
  
  // Pricing
  subtotal      Float
  tax           Float    @default(0)
  tip           Float    @default(0)
  discount      Float    @default(0)
  total         Float
  
  // Payment
  paymentStatus String   @default("pending")
  // "pending" | "paid" | "failed" | "refunded" | "partially_refunded"

  paymentMethod String?  // "stripe" | "cash" | "card"
  squarePaymentId String?  // Stripe checkout session ID (legacy field name)
  checkoutUrl   String?
  externalOrderId String?  // POS order ID
  posStatus     String?    // POS sync status
  
  // Delivery
  deliveryType  String?  // "pickup" | "delivery" | "dine-in"
  deliveryAddress String?
  scheduledFor  DateTime?
  
  // Status
  status        String   @default("pending") 
  // "pending" | "confirmed" | "preparing" | "ready" | "completed" | "cancelled"
  
  // Fulfillment
  preparedAt    DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  
  // Notes
  notes         String?  @db.Text

  // Relations
  accessGrants  AccessGrant[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([customerPhone])
  @@index([paymentStatus])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ==========================================
// CALLS (Call logs)
// ==========================================
model Call {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Call Info
  fromNumber    String
  toNumber      String   // Twilio number
  direction     String   // "inbound" | "outbound"
  
  // Duration & Recording
  duration      Int      // seconds
  recordingUrl  String?
  transcript    String?  @db.Text
  
  // AI Analysis
  intent        String?  // "faq" | "booking" | "order" | "escalation" | "unknown"
  outcome       String?  // "completed" | "escalated" | "failed" | "voicemail"
  aiConfidence  Float?
  sentiment     String?  // "positive" | "neutral" | "negative"
  
  // Linked Records
  bookingId     String?
  orderId       String?
  leadId        String?
  
  // Metadata
  metadata      Json?
  
  // Call Quality
  callQuality   Int?     // 1-5 rating
  
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([fromNumber])
  @@index([intent])
  @@index([createdAt])
  @@map("calls")
}

// ==========================================
// ADMIN USERS (Platform admins)
// ==========================================
model AdminUser {
  id            String   @id @default(uuid())
  
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("admin") // "admin" | "superadmin"
  
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@map("admin_users")
}

// ==========================================
// ACTIVITY LOG (Audit trail)
// ==========================================
model ActivityLog {
  id            String   @id @default(uuid())
  
  // Actor
  actorType     String   // "user" | "admin" | "system"
  actorId       String?
  actorEmail    String?
  
  // Target
  tenantId      String?
  
  // Action
  action        String   // "create" | "update" | "delete" | "login" | "logout"
  entityType    String   // "tenant" | "user" | "lead" | "booking" | "order"
  entityId      String?
  
  // Details
  changes       Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==========================================
// CUSTOMERS (for loyalty & follow-ups)
// ==========================================
model Customer {
  id              String   @id @default(uuid())
  tenantId        String

  phone           String
  email           String?
  name            String?

  // Loyalty
  loyaltyPoints   Int      @default(0)
  totalSpent      Float    @default(0)
  orderCount      Int      @default(0)

  // Activity
  lastActivityAt  DateTime?
  reactivationSentAt DateTime?

  // Tags
  tags            String[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

// ==========================================
// CHAT SESSIONS (Web Chat)
// ==========================================
model ChatSession {
  id              String   @id @default(uuid())
  tenantId        String

  channel         String   // "webchat" | "whatsapp"
  customerPhone   String?
  customerEmail   String?
  customerName    String?

  status          String   @default("active") // "active" | "ended" | "transferred"
  assignedAgentId String?
  transferredAt   DateTime?
  endedAt         DateTime?

  metadata        Json?

  messages        ChatMessage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("chat_sessions")
}

// ==========================================
// CHAT MESSAGES
// ==========================================
model ChatMessage {
  id            String   @id @default(uuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  channel       String   // "webchat" | "whatsapp"
  sender        String   // "user" | "agent" | "ai"
  message       String   @db.Text
  mediaUrl      String?

  metadata      Json?

  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([channel])
  @@map("chat_messages")
}

// ==========================================
// QR CODES (for ordering)
// ==========================================
model QRCode {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tableNumber   String?
  locationId    String?
  url           String

  status        String   @default("active") // "active" | "inactive"
  scanCount     Int      @default(0)
  lastScannedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("qr_codes")
}

// ==========================================
// FOLLOW-UP CONFIGS
// ==========================================
model FollowUpConfig {
  id            String   @id @default(uuid())
  tenantId      String

  type          String   // "missed_call" | "order_upsell" | "booking_reminder" | etc
  enabled       Boolean  @default(true)
  delayMinutes  Int      @default(30)
  channel       String   @default("sms") // "sms" | "email" | "whatsapp" | "all"
  template      String   @db.Text
  conditions    Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("follow_up_configs")
}

// ==========================================
// FOLLOW-UP JOBS
// ==========================================
model FollowUpJob {
  id            String   @id @default(uuid())
  tenantId      String

  type          String
  customerId    String?
  customerPhone String
  customerEmail String?

  scheduledFor  DateTime
  status        String   @default("pending") // "pending" | "sent" | "failed" | "cancelled"

  data          Json?
  error         String?
  sentAt        DateTime?

  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([scheduledFor])
  @@map("follow_up_jobs")
}

// ==========================================
// BUSINESS TYPES (Dynamic)
// ==========================================
model BusinessType {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g., "restaurant", "hotel", "medical"
  name        String   // Display name
  description String?
  icon        String?  // Icon name or URL

  // AI Configuration
  promptTemplate String? @db.Text // System prompt template

  // Available functions for this business type
  functions   BusinessTypeFunction[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_types")
}

model BusinessTypeFunction {
  id             String   @id @default(uuid())
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  name           String   // Function name (e.g., "check_availability")
  description    String   // Human-readable description
  parameters     Json?    // JSON schema for function parameters

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([businessTypeId, name])
  @@index([businessTypeId])
  @@map("business_type_functions")
}

// ==========================================
// CALL LOGS (for Retell AI)
// ==========================================
model CallLog {
  id          String    @id @default(uuid())
  callId      String    @unique
  tenantId    String?

  fromNumber  String
  toNumber    String
  status      String
  duration    Int?

  transcript  String?
  summary     String?
  sentiment   String?

  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([callId])
  @@map("call_logs")
}

// ==========================================
// MESSAGES
// ==========================================
model Message {
  id          String   @id @default(uuid())
  tenantId    String

  senderName  String
  senderPhone String
  content     String
  source      String   @default("phone")
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("messages")
}

// ==========================================
// CALLBACKS
// ==========================================
model Callback {
  id            String   @id @default(uuid())
  tenantId      String

  customerName  String
  customerPhone String
  preferredTime String?
  status        String   @default("pending")
  notes         String?

  completedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([status])
  @@map("callbacks")
}

// ==========================================
// PRODUCTS (for Retail)
// ==========================================
model Product {
  id          String   @id @default(uuid())
  tenantId    String

  name        String
  description String?
  sku         String?
  price       Float
  quantity    Int      @default(0)
  category    String?

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([sku])
  @@map("products")
}

// ==========================================
// MENU ITEMS (for Restaurant)
// ==========================================
model MenuItem {
  id          String   @id @default(uuid())
  tenantId    String

  name        String
  description String?
  price       Float
  category    String?

  isAvailable Boolean  @default(true)
  isSpecial   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@map("menu_items")
}

// ==========================================
// PROMOTIONS
// ==========================================
model Promotion {
  id          String    @id @default(uuid())
  tenantId    String

  name        String
  description String?
  discount    Float?
  code        String?

  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([isActive])
  @@map("promotions")
}

// ==========================================
// SUBSCRIPTION PLANS
// ==========================================
model Plan {
  id          String   @id @default(uuid())
  slug        String   @unique // starter, professional, enterprise, executive
  name        String
  description String?

  price       Float    // Monthly price (USD)
  yearlyPrice Float?   // Yearly price (discounted) - DEPRECATED, keeping for backwards compatibility

  // Stripe Integration
  stripeProductId String?  // Stripe product ID (e.g., prod_xxx)

  // Limits
  callMinutes             Int      // Monthly call minutes included
  maxCalls                Int      // Max calls per month (legacy field)
  maxUsers                Int      @default(1)
  maxPhoneLines           Int?     // Number of AI phone lines (1, 3, 10, null for unlimited)
  hasUnlimitedPhoneLines  Boolean  @default(false) // True for Executive plan

  // Overage Billing
  overageRatePerMinute    Float?   // Cost per minute beyond callMinutes limit ($0.50-$0.75)

  // Features
  features    Json?    // Array of feature strings

  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)

  subscriptions Subscription[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plans")
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================
model Subscription {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId      String
  plan        Plan     @relation(fields: [planId], references: [id])

  status      String   @default("active") // active, cancelled, past_due, trialing

  // Billing
  billingCycle    String   @default("monthly") // monthly, yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  // Payment
  squareCustomerId    String?
  squareSubscriptionId String?

  // Trial
  trialEndsAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

// ==========================================
// USAGE TRACKING
// ==========================================
model UsageRecord {
  id          String   @id @default(uuid())
  tenantId    String

  // Period
  periodStart DateTime
  periodEnd   DateTime

  // Usage metrics
  callMinutes   Int    @default(0)
  callCount     Int    @default(0)
  smsCount      Int    @default(0)
  apiCalls      Int    @default(0)

  // Limits from plan
  callMinutesLimit Int
  callCountLimit   Int

  // Overage tracking
  overageMinutes   Int   @default(0)  // Minutes beyond limit
  overageCharges   Float @default(0)  // Charges for overage usage

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, periodStart])
  @@index([tenantId])
  @@map("usage_records")
}

// ==========================================
// INVOICES
// ==========================================
model Invoice {
  id          String   @id @default(uuid())
  tenantId    String

  invoiceNumber String  @unique

  // Amounts
  subtotal    Float
  tax         Float    @default(0)
  total       Float

  // Status
  status      String   @default("pending") // pending, paid, failed, refunded

  // Payment
  squarePaymentId String?
  paidAt      DateTime?

  // Period
  periodStart DateTime
  periodEnd   DateTime

  // Line items
  items       InvoiceItem[]

  dueDate     DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float

  @@map("invoice_items")
}

// ==========================================
// NOTIFICATIONS
// ==========================================
model Notification {
  id          String   @id @default(uuid())
  tenantId    String?  // null for admin notifications
  userId      String?  // specific user or null for all

  type        String   // usage_warning, payment_failed, subscription_expiring, etc.
  title       String
  message     String
  data        Json?

  isRead      Boolean  @default(false)
  readAt      DateTime?

  // Delivery
  emailSent   Boolean  @default(false)
  smsSent     Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([isRead])
  @@map("notifications")
}

// ==========================================
// ANALYTICS EVENTS
// ==========================================
model AnalyticsEvent {
  id          String   @id @default(uuid())
  tenantId    String?

  eventType   String   // call_completed, booking_made, order_placed, etc.
  eventData   Json?

  // Call specific
  callDuration Int?
  callOutcome  String?  // completed, missed, transferred
  sentiment    String?  // positive, neutral, negative

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([eventType])
  @@index([createdAt])
  @@map("analytics_events")
}

// ==========================================
// TENANT INTEGRATIONS (Discord & Whop)
// ==========================================
model TenantIntegration {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Discord Configuration
  discordEnabled      Boolean  @default(false)
  discordWebhookUrl   String?  // For sending notifications
  discordBotToken     String?  // For bot operations (encrypted)
  discordGuildId      String?  // Server ID
  discordClientId     String?  // OAuth client ID
  discordClientSecret String?  // OAuth client secret (encrypted)

  // Discord Notification Settings
  notifyOnNewOrder        Boolean  @default(true)
  notifyOnPaymentSuccess  Boolean  @default(true)
  notifyOnPaymentFailed   Boolean  @default(true)
  notifyOnOrderReady      Boolean  @default(false)
  notifyOnAICall          Boolean  @default(false)
  dailyReportEnabled      Boolean  @default(false)
  dailyReportTime         String?  // HH:MM format (e.g., "23:00")

  // Whop Configuration
  whopEnabled         Boolean  @default(false)
  whopApiKey          String?  // Encrypted
  whopCompanyId       String?
  whopWebhookSecret   String?  // For webhook verification (encrypted)
  whopAutoGrantAccess Boolean  @default(true)

  // Product Mappings (JSON structure)
  // { "serviceId": { "discordRoleId": "123", "whopProductId": "prod_xyz" } }
  productMappings     Json?

  // Status
  isActive            Boolean  @default(true)
  lastSyncAt          DateTime?

  // Relations
  accessGrants        AccessGrant[]
  integrationEvents   IntegrationEvent[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_integrations")
}

// ==========================================
// ACCESS GRANTS (Discord Role Management)
// ==========================================
model AccessGrant {
  id                  String   @id @default(uuid())
  integrationId       String
  integration         TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Customer Info
  customerEmail       String?
  customerPhone       String?
  discordUserId       String?  // Discord user ID
  discordUsername     String?  // Discord username for logging

  // Access Details
  discordRoleId       String?
  discordRoleName     String?  // For display purposes

  // Whop Info
  whopMembershipId    String?  // Whop membership ID
  whopProductId       String?  // Whop product ID

  // Status
  status              String   @default("pending") // pending, granted, revoked, expired
  grantedAt           DateTime?
  expiresAt           DateTime?
  revokedAt           DateTime?
  revokeReason        String?  // "refund", "subscription_cancelled", "manual", etc.

  // Source tracking
  source              String   // "stripe", "whop", "agent", "manual"
  sourceId            String?  // Stripe session ID, Whop payment ID, etc.

  // Metadata
  metadata            Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([integrationId])
  @@index([orderId])
  @@index([discordUserId])
  @@index([status])
  @@index([expiresAt])
  @@map("access_grants")
}

// ==========================================
// INTEGRATION EVENTS (Webhook Logs)
// ==========================================
model IntegrationEvent {
  id                String   @id @default(uuid())
  integrationId     String
  integration       TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Event Info
  source            String   // "discord", "whop", "stripe"
  eventType         String   // "payment.succeeded", "membership.cancelled", etc.
  eventId           String?  // External event ID

  // Payload
  payload           Json?    // Full webhook payload

  // Processing
  status            String   @default("pending") // pending, processed, failed
  processedAt       DateTime?
  error             String?  @db.Text
  retryCount        Int      @default(0)

  // Related Records
  orderId           String?
  accessGrantId     String?

  createdAt         DateTime @default(now())

  @@index([integrationId])
  @@index([source])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("integration_events")
}

// ==========================================
// WHOP PRODUCTS (Product Sync)
// ==========================================
model WhopProduct {
  id                String   @id @default(uuid())
  tenantId          String

  // Whop Info
  whopProductId     String   @unique
  whopCompanyId     String

  // Product Details
  name              String
  description       String?  @db.Text
  price             Float
  currency          String   @default("USD")

  // Type
  type              String   // "one_time", "subscription", "membership"
  billingPeriod     String?  // "monthly", "yearly", "lifetime"

  // Discord Integration
  discordRoleId     String?  // Auto-assign this role on purchase
  discordRoleName   String?
  accessDuration    Int?     // Days (null = lifetime)

  // Mapping to internal service
  serviceId         String?  // Link to Service model

  // Status
  isActive          Boolean  @default(true)
  lastSyncAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([whopProductId])
  @@map("whop_products")
}

// ==========================================
// CERTIFIED REP PROGRAM
// ==========================================

model CertifiedRep {
  id          String   @id @default(uuid())
  userId      String   @unique  // First Ring AI user account
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Whop Integration
  whopMemberId      String?  @unique  // Whop membership ID
  whopProductId     String?           // $997 product ID
  whopSubscriptionId String?          // Active subscription

  // Status
  status            String   @default("pending")
  // "pending" | "active" | "suspended" | "cancelled"

  // Discord Access
  discordUserId     String?  @unique
  discordRoleId     String?  // Role assigned
  discordRoleName   String?  // Role name (e.g., "Certified Rep")
  accessGrantedAt   DateTime?
  accessRevokedAt   DateTime?

  // Payment
  subscriptionActive Boolean  @default(false)
  lastPaymentAt      DateTime?
  paymentFailedAt    DateTime?

  // Performance Tracking
  totalClients       Int      @default(0)
  activeClients      Int      @default(0)
  totalRevenue       Float    @default(0)
  lifetimeValue      Float    @default(0)

  // Clients managed by this rep
  clients           RepClient[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([whopMemberId])
  @@index([status])
  @@index([subscriptionActive])
  @@map("certified_reps")
}

model RepClient {
  id              String   @id @default(uuid())
  repId           String
  rep             CertifiedRep @relation(fields: [repId], references: [id], onDelete: Cascade)

  // Client Info
  clientName      String
  clientEmail     String
  clientPhone     String?
  businessType    String?  // restaurant, med_spa, law_firm, etc.

  // Pricing (what rep charges)
  setupFee        Float?
  monthlyFee      Float?
  currency        String   @default("USD")

  // Status
  status          String   @default("prospect")
  // "prospect" | "demo_scheduled" | "proposal_sent" | "active" | "churned"

  // Conversion
  tenantId        String?  @unique  // If converted to actual tenant
  convertedAt     DateTime?

  // Notes
  notes           String?  @db.Text

  // Deal tracking
  dealValue       Float?   // Total contract value
  closeDate       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([repId])
  @@index([status])
  @@index([tenantId])
  @@map("rep_clients")
}
