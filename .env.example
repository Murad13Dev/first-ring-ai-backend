# ==========================================
# STRIPE CONFIGURATION
# ==========================================

# Stripe API Keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs for Subscriptions (Monthly)
# Run: npx ts-node scripts/create-stripe-prices.ts (to auto-generate)
# Or create manually: https://dashboard.stripe.com/products
STRIPE_PRICE_ID_STARTER=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PROFESSIONAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_EXECUTIVE=price_xxxxxxxxxxxxx

# Stripe Price IDs for Subscriptions (Yearly)
# Run: npx ts-node scripts/create-stripe-yearly-prices.ts (to auto-generate)
STRIPE_PRICE_ID_STARTER_YEARLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PROFESSIONAL_YEARLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_EXECUTIVE_YEARLY=price_xxxxxxxxxxxxx

# Stripe Setup Fee Product
# $1 one-time setup fee product (for yearly subscriptions)
STRIPE_SETUP_FEE_PRODUCT_ID=prod_Tp9UDaztizJSBf

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

# SendGrid (or SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@firstring.ai
SALES_EMAIL=sales@firstring.ai

# ==========================================
# DATABASE
# ==========================================

DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# ==========================================
# WHOP INTEGRATION (Partner Subscriptions)
# ==========================================

WHOP_API_KEY=your_whop_api_key_here
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret_here
WHOP_COMPANY_ID=your_whop_company_id_here

# ==========================================
# TOAST POS INTEGRATION (Restaurant POS)
# ==========================================

# Mario's Butcher or other Toast customers
TOAST_RESTAURANT_ID=your_toast_restaurant_external_id_here
TOAST_ACCESS_TOKEN=your_toast_access_token_here
TOAST_ENVIRONMENT=sandbox  # or 'production'

# ==========================================
# OTHER POS SYSTEMS (Optional)
# ==========================================

# Square
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_ENVIRONMENT=sandbox  # or 'production'

# Clover
CLOVER_API_KEY=your_clover_api_key_here
CLOVER_MERCHANT_ID=your_clover_merchant_id_here
CLOVER_ENVIRONMENT=sandbox  # or 'production'

# ==========================================
# INSTRUCTIONS
# ==========================================

# 1. Copy this file to .env
# 2. Fill in all the values
# 3. Create Stripe Price IDs:
#    Option A (Automated): Run the script
#      npx ts-node scripts/create-stripe-prices.ts
#    Option B (Manual): Create in Stripe Dashboard
#      - Go to https://dashboard.stripe.com/products
#      - For each product (prod_xxx), create a price
#      - Set recurring pricing ($500, $1500, $3000, $5000 monthly)
#      - Copy the Price ID (starts with "price_") for each plan
# 4. Configure email provider (SendGrid recommended)
# 5. Configure integrations:
#    - Whop: See WHOP_SETUP.md for partner subscriptions
#    - Toast POS: See docs/TOAST_POS_SETUP.md for restaurant integration
#    - Other POS: Contact provider for API credentials
# 6. See STRIPE_SETUP.md for detailed instructions
